# Dunst · Benachrichtigungen
# Nord, Maße wie Hyprland (lua/theme.lua): 10 px vom Rand und unter der Leiste,
# Rundung 10. Einzelne Karten statt Trennlinien. Kritisches wird nicht rot
# geflutet, sondern bekommt einen roten Rahmen.

[global]
    origin = top-right
    offset = (10, 10)
    width = 380
    height = (0, 240)
    notification_limit = 5
    gap_size = 8

    font = Adwaita Sans 11
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    word_wrap = yes
    ellipsize = end
    ignore_newline = no
    show_age_threshold = 60

    padding = 14
    horizontal_padding = 16
    text_icon_padding = 14
    corner_radius = 10
    frame_width = 1
    separator_height = 0

    icon_position = left
    icon_theme = "Nordzy-dark, Papirus-Dark"
    enable_recursive_icon_lookup = true
    min_icon_size = 32
    max_icon_size = 56
    icon_corner_radius = 6

    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 3
    highlight = "#88c0d0"

    sort = urgency_descending
    idle_threshold = 120
    history_length = 30
    indicate_hidden = yes
    stack_duplicates = true
    hide_duplicate_count = false

    dmenu = /usr/bin/fuzzel --dmenu --prompt "Aktion  "
    browser = /usr/bin/xdg-open

    mouse_left_click = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current

# Text zu 75 % über dem Hintergrund: leiser als normal
[urgency_low]
    background = "#2e3440f2"
    foreground = "#adb3bf"
    frame_color = "#3b4252"
    timeout = 5

[urgency_normal]
    background = "#2e3440f2"
    foreground = "#d8dee9"
    frame_color = "#3b4252"
    timeout = 8

[urgency_critical]
    background = "#2e3440f5"
    foreground = "#eceff4"
    frame_color = "#bf616a"
    highlight = "#bf616a"
    timeout = 0
