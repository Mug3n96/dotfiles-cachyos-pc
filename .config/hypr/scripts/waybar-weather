#!/usr/bin/env python3
"""Wetter für die Waybar (mittlere Insel), Daten von Open-Meteo, ohne API-Key.

Ort: ~/.config/waybar/weather.local (bewusst nicht im Repo):
    Stadtname           z. B. "Hamburg"
    oder Breite,Länge   z. B. "53.55,9.99"
    pollen=12           optional: DWD-Pollenflug-Region (partregion_id, sonst region_id)
                        aus https://opendata.dwd.de/climate_environment/health/alerts/s31fg.json
Ohne Datei wird der Ort grob über die IP geschätzt (ipinfo.io), Pollen gibt es dann nicht.
Pollen: Pollenflug-Gefahrenindex des Deutschen Wetterdienstes, einmal täglich ~11 Uhr.

Läuft dauerhaft und gibt alle 15 min eine JSON-Zeile für Waybar aus. Ohne Netz
bleiben die letzten Daten bis zu 3 h stehen, danach blendet sich das Modul aus.
"""

import html
import json
import os
import sys
import time
import urllib.parse
import urllib.request
from datetime import date, datetime

CONF    = os.path.expanduser("~/.config/waybar/weather.local")
CACHE   = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")),
                       "waybar-weather.json")
REFRESH = 15 * 60
RETRY   = 60
STALE   = 3 * 3600

POLLEN_URL   = "https://opendata.dwd.de/climate_environment/health/alerts/s31fg.json"
POLLEN_EVERY = 3600

ACCENT2 = "#81a1c1"
YELLOW  = "#ebcb8b"
RED     = "#bf616a"
MONO    = "JetBrainsMono Nerd Font"

# WMO-Wettercode → (Text, Icon Tag, Icon Nacht)
SUN, MOON = "\U000f0599", "\U000f0594"
PARTLY, PARTLY_N = "\U000f0595", "\U000f0f31"
CLOUD, FOG = "\U000f0590", "\U000f0591"
RAIN, POUR = "\U000f0597", "\U000f0596"
SNOW, SLEET = "\U000f0598", "\U000f067f"
STORM = "\U000f067e"
SUNRISE, SUNSET = "\U000f059c", "\U000f059b"

WMO = {
    0:  ("Klar",                     SUN,    MOON),
    1:  ("Überwiegend klar",         PARTLY, PARTLY_N),
    2:  ("Teils bewölkt",            PARTLY, PARTLY_N),
    3:  ("Bedeckt",                  CLOUD,  CLOUD),
    45: ("Nebel",                    FOG,    FOG),
    48: ("Reifnebel",                FOG,    FOG),
    51: ("Leichter Nieselregen",     RAIN,   RAIN),
    53: ("Nieselregen",              RAIN,   RAIN),
    55: ("Starker Nieselregen",      RAIN,   RAIN),
    56: ("Gefrierender Niesel",      SLEET,  SLEET),
    57: ("Gefrierender Niesel",      SLEET,  SLEET),
    61: ("Leichter Regen",           RAIN,   RAIN),
    63: ("Regen",                    RAIN,   RAIN),
    65: ("Starker Regen",            POUR,   POUR),
    66: ("Gefrierender Regen",       SLEET,  SLEET),
    67: ("Gefrierender Regen",       SLEET,  SLEET),
    71: ("Leichter Schneefall",      SNOW,   SNOW),
    73: ("Schneefall",               SNOW,   SNOW),
    75: ("Starker Schneefall",       SNOW,   SNOW),
    77: ("Schneegriesel",            SNOW,   SNOW),
    80: ("Leichte Regenschauer",     RAIN,   RAIN),
    81: ("Regenschauer",             POUR,   POUR),
    82: ("Heftige Regenschauer",     POUR,   POUR),
    85: ("Leichte Schneeschauer",    SNOW,   SNOW),
    86: ("Schneeschauer",            SNOW,   SNOW),
    95: ("Gewitter",                 STORM,  STORM),
    96: ("Gewitter mit Hagel",       STORM,  STORM),
    99: ("Gewitter mit Hagel",       STORM,  STORM),
}
DAYS = ["Mo", "Di", "Mi", "Do", "Fr", "Sa", "So"]


def get_json(url, params=None):
    if params:
        url += "?" + urllib.parse.urlencode(params)
    req = urllib.request.Request(url, headers={"User-Agent": "waybar-weather"})
    with urllib.request.urlopen(req, timeout=10) as r:
        return json.load(r)


_located = {}  # Ort nur einmal auflösen, neu nur wenn sich weather.local ändert


def read_conf():
    """(Ort, {schlüssel: wert}) aus weather.local; Zeilen mit "=" sind Optionen."""
    spec, opts = "", {}
    try:
        with open(CONF) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                if "=" in line:
                    k, v = line.split("=", 1)
                    opts[k.strip()] = v.strip()
                elif not spec:
                    spec = line
    except FileNotFoundError:
        pass
    return spec, opts


def location():
    """(lat, lon, name, geschätzt?) aus weather.local, sonst per IP."""
    spec, _ = read_conf()
    if spec not in _located:
        _located.clear()
        _located[spec] = resolve(spec)
    return _located[spec]


def resolve(spec):
    if spec:
        try:
            lat, lon = (float(x) for x in spec.split(","))
            return lat, lon, None, False
        except ValueError:
            pass
        hits = get_json("https://geocoding-api.open-meteo.com/v1/search",
                        {"name": spec, "count": 1, "language": "de", "format": "json"})
        if not hits.get("results"):
            raise LookupError(f"Ort nicht gefunden: {spec}")
        hit = hits["results"][0]
        return hit["latitude"], hit["longitude"], hit["name"], False

    ip = get_json("https://ipinfo.io/json")
    lat, lon = (float(x) for x in ip["loc"].split(","))
    return lat, lon, ip.get("city"), True


_pollen_raw = {"at": 0.0, "data": None}


def pollen():
    """{"region": Name, "days": [heute, morgen]} für die DWD-Region aus weather.local, sonst None.

    Der DWD gibt einmal täglich um ~11 Uhr aus. Vorher ist "today" in der Datei noch
    gestern, dann rückt alles um einen Tag: tomorrow → heute, dayafter_to → morgen
    (dayafter_to gibt es nur freitags, sonst "-1" = unbekannt).
    """
    region = read_conf()[1].get("pollen")
    if not region:
        return None
    if time.time() - _pollen_raw["at"] > POLLEN_EVERY:
        try:
            _pollen_raw["data"] = get_json(POLLEN_URL)
            _pollen_raw["at"] = time.time()
        except Exception as e:  # Pollen sind Beiwerk: Wetter trotzdem zeigen
            print(f"waybar-weather: Pollen: {e}", file=sys.stderr)
            _pollen_raw["at"] = time.time() - POLLEN_EVERY + 5 * 60  # in 5 min nochmal
    raw = _pollen_raw["data"]
    if not raw:
        return None

    rid = int(region)
    entry = next((r for r in raw["content"] if r["partregion_id"] == rid), None) or \
            next((r for r in raw["content"] if r["region_id"] == rid and r["partregion_id"] == -1), None)
    if not entry:
        return None
    lag = (date.today() - date.fromisoformat(raw["last_update"][:10])).days
    keys = {0: ("today", "tomorrow"), 1: ("tomorrow", "dayafter_to")}.get(lag)
    if not keys:
        return None
    days = [{plant: vals.get(k, "-1") for plant, vals in entry["Pollen"].items()} for k in keys]
    return {"region": entry["partregion_name"] or entry["region_name"], "days": days}


def fetch():
    lat, lon, name, guessed = location()
    data = get_json("https://api.open-meteo.com/v1/forecast", {
        "latitude": lat, "longitude": lon, "timezone": "auto", "forecast_days": 3,
        "current": "temperature_2m,apparent_temperature,weather_code,is_day,"
                   "wind_speed_10m,relative_humidity_2m",
        "hourly":  "temperature_2m,weather_code,precipitation_probability,is_day",
        "daily":   "weather_code,temperature_2m_max,temperature_2m_min,"
                   "precipitation_probability_max,sunrise,sunset",
    })
    data["_name"], data["_guessed"], data["_fetched"] = name, guessed, time.time()
    data["_pollen"] = pollen()
    return data


def icon(code, is_day=1):
    _, day, night = WMO.get(code, ("", CLOUD, CLOUD))
    return day if is_day else night


def pct(v):
    return "  –" if v is None else f"{v:3d} %"


# DWD-Index → (Stufe, Text). Gelb ab "gering bis mittel", Rot ab "mittel bis hoch".
POLLEN_LEVEL = {"0": (0, "keine"), "0-1": (0.5, "keine–gering"), "1": (1, "gering"),
                "1-2": (1.5, "gering–mittel"), "2": (2, "mittel"), "2-3": (2.5, "mittel–hoch"),
                "3": (3, "hoch")}
POLLEN_NAMES = {"Graeser": "Gräser", "Beifuss": "Beifuß"}


def pollen_lines(p):
    def lvl(code):
        return POLLEN_LEVEL.get(code, (0, "–"))

    def cell(code, width):
        v, txt = lvl(code)
        pad = " " * max(0, width - len(txt))
        color = RED if v >= 2.5 else YELLOW if v >= 1.5 else None
        return (f"<span color='{color}'>{txt}</span>" if color else txt) + pad

    today, tomorrow = p["days"]
    active = [k for k in today if max(lvl(today[k])[0], lvl(tomorrow.get(k))[0]) > 0]
    if not active:
        return [f"<span color='{ACCENT2}'>Pollen</span>  keine Belastung heute und morgen"]
    active.sort(key=lambda k: max(lvl(today[k])[0], lvl(tomorrow.get(k))[0]), reverse=True)
    rows = [f"{'':9}{'heute':<15}morgen"]
    rows += [f"{POLLEN_NAMES.get(k, k):<9}{cell(today[k], 15)}{cell(tomorrow.get(k, '-1'), 0)}"
             for k in active]
    return [f"<span color='{ACCENT2}'>Pollen</span>",
            f"<span font_family='{MONO}'>" + "\n".join(rows) + "</span>"]


def render(d, stale=False):
    cur, hourly, daily = d["current"], d["hourly"], d["daily"]
    desc = WMO.get(cur["weather_code"], ("Unbekannt",))[0]

    head = f"<b>{html.escape(d['_name'])}</b>  ·  {desc}" if d.get("_name") else f"<b>{desc}</b>"
    lines = [
        head,
        f"Gefühlt {round(cur['apparent_temperature'])}°  ·  Wind {round(cur['wind_speed_10m'])} km/h"
        f"  ·  Feuchte {cur['relative_humidity_2m']} %",
        f"{SUNRISE} {daily['sunrise'][0][11:16]}    {SUNSET} {daily['sunset'][0][11:16]}",
        "",
        f"<span color='{ACCENT2}'>Nächste Stunden</span>",
    ]

    # Ab der nächsten vollen Stunde, 6 Stunden weit
    now = cur["time"][:13]
    start = next((i for i, t in enumerate(hourly["time"]) if t[:13] == now), 0) + 1
    rows = []
    for i in range(start, min(start + 6, len(hourly["time"]))):
        rows.append(f"{hourly['time'][i][11:13]} Uhr  "
                    f"{icon(hourly['weather_code'][i], hourly['is_day'][i])}  "
                    f"{round(hourly['temperature_2m'][i]):3d}°  "
                    f"{pct(hourly['precipitation_probability'][i])}")
    lines.append(f"<span font_family='{MONO}'>" + "\n".join(rows) + "</span>")

    lines += ["", f"<span color='{ACCENT2}'>Nächste Tage</span>"]
    rows = []
    for i, day in enumerate(daily["time"]):
        label = ("Heute", "Morgen")[i] if i < 2 else DAYS[datetime.fromisoformat(day).weekday()]
        rows.append(f"{label:<6}  {icon(daily['weather_code'][i])}  "
                    f"{round(daily['temperature_2m_max'][i]):3d}° / {round(daily['temperature_2m_min'][i]):3d}°  "
                    f"{pct(daily['precipitation_probability_max'][i])}")
    lines.append(f"<span font_family='{MONO}'>" + "\n".join(rows) + "</span>")

    if d.get("_pollen"):
        lines += [""] + pollen_lines(d["_pollen"])

    notes = []
    if d.get("_guessed"):
        notes.append("Ort per IP geschätzt · fester Ort: ~/.config/waybar/weather.local")
    if d.get("_pollen"):
        notes.append("Pollen: Deutscher Wetterdienst · " + html.escape(d["_pollen"]["region"]))
    if stale:
        notes.append("Stand " + datetime.fromtimestamp(d["_fetched"]).strftime("%H:%M") + ", kein Netz")
    if notes:
        lines += [""] + [f"<span fgalpha='70%'>{n}</span>" for n in notes]

    return {
        "text":    f"<span fgalpha='88%'>{icon(cur['weather_code'], cur['is_day'])}</span>  "
                   f"{round(cur['temperature_2m'])}°",
        "tooltip": "\n".join(lines),
        "class":   "stale" if stale else "fresh",
    }


def emit(obj):
    try:
        print(json.dumps(obj, ensure_ascii=False), flush=True)
    except BrokenPipeError:
        # Waybar hat das Modul beendet (Neuladen): leise aufhören
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(0)


def load_cache():
    try:
        with open(CACHE) as f:
            d = json.load(f)
        return d if time.time() - d["_fetched"] < STALE else None
    except (OSError, ValueError, KeyError):
        return None


def wait(seconds):
    # In kleinen Schritten gegen die Uhrzeit warten: nach dem Aufwachen aus dem
    # Standby wird sofort aktualisiert statt erst nach Ablauf der Restzeit.
    due = time.time() + seconds
    while time.time() < due:
        time.sleep(min(30, max(1, due - time.time())))


def main():
    cached = load_cache()
    if cached:  # sofort etwas zeigen, auch wenn das Netz beim Start noch fehlt
        emit(render(cached, stale=time.time() - cached["_fetched"] > REFRESH + RETRY))

    while True:
        try:
            data = fetch()
            os.makedirs(os.path.dirname(CACHE), exist_ok=True)
            with open(CACHE, "w") as f:
                json.dump(data, f)
            emit(render(data))
            wait(REFRESH)
        except Exception as e:  # Netz weg, Dienst down, Ort unbekannt
            print(f"waybar-weather: {e}", file=sys.stderr)
            cached = load_cache()
            emit(render(cached, stale=True) if cached else {"text": "", "tooltip": ""})
            wait(RETRY)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
