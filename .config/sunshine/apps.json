{
  "apps": [
    {
      "image-path": "desktop.png",
      "name": "Desktop"
    },
    {
      "auto-detach": true,
      "exclude-global-prep-cmd": false,
      "exit-timeout": 5,
      "image-path": "/home/mug3n96/Pictures/sunshine_icons/ipad.png",
      "name": "Low Res Desktop",
      "prep-cmd": [
        {
          "do": "hyprctl eval \"hl.monitor({ output = 'DP-3', mode = '1600x1117@120', position = '0x0', scale = 1 })\"",
          "undo": "hyprctl eval \"hl.monitor({ output = 'DP-3', mode = '2560x1440@165', position = '0x0', scale = 1 })\""
        }
      ],
      "wait-all": true
    },
    {
      "detached": [
        "setsid steam steam://open/bigpicture"
      ],
      "image-path": "steam.png",
      "name": "Steam Big Picture",
      "prep-cmd": [
        {
          "do": "",
          "undo": "setsid steam steam://close/bigpicture"
        }
      ]
    }
  ],
  "env": {
    "PATH": "$(PATH):$(HOME)/.local/bin"
  }
}
