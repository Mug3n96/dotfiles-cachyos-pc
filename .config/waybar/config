// Waybar · drei Inseln: Workspaces | Uhr | System
// Maße wie Hyprland (lua/theme.lua): 10 px Abstand, 10 px Rundung.
{
  "layer": "top",
  "position": "top",
  "exclusive": true,
  "height": 36,
  "margin-top": 10,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 0,
  "reload_style_on_change": true,

  "modules-left": ["custom/launcher", "hyprland/workspaces", "custom/scratchpad", "hyprland/submap"],
  "modules-center": ["clock"],
  "modules-right": ["tray", "pulseaudio", "cpu", "memory", "temperature", "network", "custom/power"],

  "custom/launcher": {
    "format": "󰣇",
    "tooltip": false,
    "on-click": "fuzzel"
  },

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{icon}",
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": "󰺷",
      "6": "",
      "7": "",
      "8": "",
      "default": ""
    }
  },

  // Scratchpad (SUPER+Minus): Klick blendet ein/aus, Rechtsklick legt das aktive Fenster hinein
  "custom/scratchpad": {
    "exec": "~/.config/hypr/scripts/waybar-scratchpad",
    "return-type": "json",
    "restart-interval": 2,
    "on-click": "~/.config/hypr/scripts/waybar-scratchpad toggle",
    "on-click-right": "~/.config/hypr/scripts/waybar-scratchpad send"
  },

  "hyprland/submap": {
    "format": "󰩨  {}",
    "tooltip": false
  },

  "clock": {
    "locale": "de_DE.UTF-8",
    "format": "<span fgalpha='88%'>{0:L%a %d. %b}</span>   <span weight='600'>{0:%H:%M}</span>",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "left",
      "format": {
        "months":   "<b>{}</b>",
        "weeks":    "<span color='#7b88a1'>{:%V}</span>",
        "weekdays": "<span color='#81a1c1'>{}</span>",
        "today":    "<span color='#88c0d0'><b>{}</b></span>"
      }
    }
  },

  "tray": {
    "icon-size": 16,
    "spacing": 10
  },

  "pulseaudio": {
    "format": "<span fgalpha='88%'>{icon}</span>  {volume}%",
    "format-muted": "󰝟  {volume}%",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "tooltip-format": "{desc}"
  },

  "cpu": {
    "format": "<span fgalpha='88%'>󰓅</span>  {usage}%",
    "states": { "warning": 75, "critical": 90 },
    "tooltip": false
  },

  "memory": {
    "format": "<span fgalpha='88%'>󰍛</span>  {used:0.1f}G",
    "states": { "warning": 75, "critical": 90 },
    "tooltip-format": "{used:0.1f} von {total:0.1f} GiB"
  },

  // k10temp Tctl, die echte CPU-Temperatur (thermal_zone0 ist ein ACPI-Fühler)
  "temperature": {
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    "input-filename": "temp1_input",
    "critical-threshold": 85,
    "format": "<span fgalpha='88%'>󰔏</span>  {temperatureC}°",
    "tooltip-format": "CPU (Tctl) {temperatureC} °C"
  },

  "network": {
    "format-ethernet": "<span fgalpha='88%'>󰈀</span>",
    "format-wifi": "<span fgalpha='88%'>󰖩</span>  {signalStrength}%",
    "format-disconnected": "󰖪",
    "tooltip-format": "{ifname} · {ipaddr}",
    "tooltip-format-disconnected": "Keine Verbindung"
  },

  "custom/power": {
    "format": "󰐥",
    "tooltip": false,
    "on-click": "~/.config/hypr/scripts/powermenu"
  }
}
